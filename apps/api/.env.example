# --- Core ---
NODE_ENV=development
PORT=3001
# Public URL of the API (used for webhook + file links)
APP_URL=http://localhost:3001
# Public URL of the web frontend (CORS + links in emails/bot)
WEB_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://multilevel:multilevel_dev_password@localhost:5432/multilevel?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
# Google OAuth (frontend obtains ID token, backend verifies)
GOOGLE_CLIENT_ID=
# Secret used to hash OTP codes (falls back to JWT_ACCESS_SECRET)
OTP_SECRET=change-me-otp-secret

# --- Email (OTP login, password reset) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail address>,
# SMTP_PASS=<16-char App Password from myaccount.google.com/apppasswords, needs 2FA>
# Leave SMTP_HOST empty in dev — codes are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=multilevel.wisar.uz <no-reply@wisar.uz>

# --- AI (provider-swappable: gemini now, anthropic later) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Username without @ — used to build t.me deep links (phone OTP onboarding)
TELEGRAM_BOT_USERNAME=
# In production the bot runs via webhook: {APP_URL}/telegram/webhook/{TELEGRAM_WEBHOOK_SECRET}
# In development it uses long polling automatically.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# --- Files ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
