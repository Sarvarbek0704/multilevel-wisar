            },
            {
              "type": "GAP_FILL",
              "skill": "GRAMMAR",
              "promptUz": "Qavs ichidagi fe'lni to'g'ri shaklda yozing:",
              "data": { "text": "She ___ (study) at the university." },
              "answer": { "accept": ["studies"] },
              "explanationUz": "undosh + y → -ies: studies."
            },
            {
              "type": "MCQ_SINGLE",
              "skill": "GRAMMAR",
              "promptUz": "Qaysi gap TO'G'RI?",
              "data": { "options": ["He have two brothers.", "He has two brothers.", "He haves two brothers.", "He is have two brothers."] },
              "answer": { "value": "He has two brothers." },
              "explanationUz": "«have» 3-shaxs birlikda «has» bo'ladi — istisno fe'l."
            },
            {
              "type": "MATCHING",
              "skill": "GRAMMAR",
              "promptUz": "Egani mos fe'l shakli bilan bog'lang:",
              "data": { "left": ["I", "My sister", "They", "The dog"], "right": ["barks", "read books", "wake up early", "teaches math"] },
              "answer": { "pairs": { "I": "wake up early", "My sister": "teaches math", "They": "read books", "The dog": "barks" } },
              "explanationUz": "I/They — asos shakl; my sister/the dog (he-she-it) — fe'l + s."
            }
          ]
