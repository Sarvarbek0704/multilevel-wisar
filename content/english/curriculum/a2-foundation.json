        {
          "slug": "verb-to-be",
          "titleUz": "«To be» fe'li: am / is / are",
          "titleEn": "The verb 'to be'",
          "skill": "GRAMMAR",
          "level": "A2",
          "order": 0,
          "estimatedMinutes": 20,
          "objectivesUz": [
            "am/is/are ni to'g'ri tanlash",
            "To be bilan darak, inkor va so'roq gaplar tuzish",
            "Qisqartmalarni (I'm, he's, they're) ishlatish"
          ],
          "content": [
            {
              "type": "theory",
              "titleUz": "«To be» nima uchun kerak?",
              "bodyUz": "Ingliz tilida «to be» (bo'lmoq) — eng ko'p ishlatiladigan fe'l. O'zbek tilida biz «Men talabaman» deymiz — «man» qo'shimchasi vazifasini ingliz tilida **am/is/are** bajaradi.\n\n- **I am** — men ...man\n- **He/She/It is** — u ...dir\n- **We/You/They are** — biz/siz/ular ...miz/siz/lar"
            },
            {
              "type": "example",
              "titleUz": "Misollar",
              "items": [
                { "en": "I am a student.", "uz": "Men talabaman." },
                { "en": "She is a doctor.", "uz": "U shifokor." },
                { "en": "They are from Tashkent.", "uz": "Ular Toshkentdan." },
                { "en": "It is cold today.", "uz": "Bugun havo sovuq." }
              ]
            },
            {
              "type": "table",
              "titleUz": "Qisqartmalar",
              "headers": ["To'liq shakl", "Qisqartma", "Tarjima"],
              "rows": [
                ["I am", "I'm", "men ...man"],
                ["He is", "He's", "u ...dir"],
                ["She is", "She's", "u ...dir"],
                ["We are", "We're", "biz ...miz"],
                ["They are", "They're", "ular ...lar"]
              ]
            },
            {
              "type": "theory",
              "titleUz": "Inkor va so'roq",
              "bodyUz": "**Inkor:** be dan keyin **not** qo'shiladi: *I am not tired. She isn't a teacher.*\n\n**So'roq:** be gapning boshiga chiqadi: *Are you ready? Is he at home?*\n\nQisqa javoblar: *Yes, I am. / No, I'm not. / Yes, she is. / No, she isn't.*"
            },
            {
              "type": "tip",
              "bodyUz": "Imtihonda eng ko'p uchraydigan xato: «He are», «They is». Egani aniqlab oling: birlikmi (is) yoki ko'plikmi (are)? «I» esa doim «am» bilan!"
            }
          ],
          "exercises": [
            {
              "type": "MCQ_SINGLE",
              "skill": "GRAMMAR",
              "promptUz": "To'g'ri variantni tanlang:",
              "data": { "text": "My brother ___ an engineer.", "options": ["am", "is", "are", "be"] },
